#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <12 13>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <21 22>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <22 23>;
        };

        cut {
            bindings = <&kp K_CUT>;
            key-positions = <21 23>;
        };

        r_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
        };

        mse {
            bindings = <&tog 4>;
            key-positions = <9 8>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q     &kp W   &kp E    &kp R     &kp T      &kp Y      &kp U     &kp I      &kp O    &kp P
&kp A     &kp S   &kp D    &kp F     &kp G      &kp H      &kp J     &kp K      &kp L    &kp SEMI
&kp Z     &kp X   &kp C    &kp V     &kp B      &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH
                  &kp RET  &mo 1     &kp ENTER  &kp SPACE  &mo 2     &kp RET
&kp LEFT  &kp UP  &kp RET  &kp DOWN  &kp RIGHT  &kp LEFT   &kp DOWN  &kp RET    &kp UP   &kp RIGHT
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_D_U>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH          &kp DOLLAR            &kp PERCENT     &kp CARET        &kp AMPERSAND          &kp ASTERISK       &kp EQUAL  &kp QUESTION
&kp GRAVE        &kp MINUS       &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp PLUS   &kp DOUBLE_QUOTES
&kp TILDE        &kp UNDERSCORE  &kp LESS_THAN     &kp COMMA             &kp COLON       &kp SEMICOLON    &kp DOT                &kp GREATER_THAN   &kp PIPE   &kp SINGLE_QUOTE
                                 &trans            &trans                &trans          &trans           &trans                 &trans
&trans           &trans          &trans            &trans                &trans          &trans           &trans                 &trans             &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRI_UP C_BRI_DEC>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&kp NUMBER_1       &kp N2          &kp N3        &kp N4        &kp N5     &kp N6          &kp N7          &kp N8        &kp N9           &kp N0
&kp PRINTSCREEN    &sk LEFT_SHIFT  &sk LEFT_ALT  &sk LEFT_GUI  &sk LCTRL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE
&kp K_APPLICATION  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &kp LCTRL  &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp INSERT
                                   &trans        &trans        &sk LCTRL  &sk LEFT_SHIFT  &trans          &trans
&trans             &trans          &trans        &trans        &trans     &trans          &trans          &trans        &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREVIOUS>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        fnc_layer {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7  &kp F8        &kp F9        &kp F10
&trans        &trans        &trans        &trans        &kp F11       &kp F12       &trans  &trans        &trans        &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp CAPSLOCK  &trans  &out OUT_USB  &out OUT_BLE  &bt BT_CLR
                            &trans        &trans        &trans        &trans        &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        mice_layer {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &mkp LCLK       &msc SCRL_DOWN   &msc SCRL_UP  &mkp RCLK        &mkp MCLK
&trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans     &trans     &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans        &trans           &trans
                &trans  &trans     &trans     &trans          &trans           &trans
&trans  &trans  &trans  &trans     &trans     &trans          &trans           &trans        &trans           &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fnc {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
