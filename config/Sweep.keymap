#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        // Per-profile select-or-clear. Tap = select that BLE profile (same as
        // plain `&bt BT_SEL N` before). Hold ~3s = select AND clear that
        // profile's bond in one action (see bt_clr_N macros below), so
        // clearing one specific profile no longer depends on landing two
        // separate keypresses (BT_SEL N then the shared BT_CLR key) while
        // holding the fnc_layer chord (mo 1 + mo 2 via conditional_layers) -
        // dropping the chord between those two presses silently sent BT_CLR
        // to the default layer instead of clearing anything. 3s (not the
        // 300ms used for &mt/&lt above) matches &soft_off's hold-time-ms
        // below, on purpose: this deletes pairing data, so it should take a
        // deliberate hold, not a quick tap-preferred resolve.
        //
        // NOTE: clearing a profile here only clears the KEYBOARD's side of
        // the bond. You must also "forget"/remove the matching device on the
        // host (computer/phone) side, or it will keep trying to reconnect
        // and fail ("Security failed") - this is a hard BLE requirement ZMK
        // documents itself, not something a keymap/firmware change can fix.
        bhs0: bhs0 {
            compatible = "zmk,behavior-hold-tap";
            label = "BHS0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt_clr_0>;
            tapping-term-ms = <3000>;
            flavor = "hold-preferred";
        };

        bhs1: bhs1 {
            compatible = "zmk,behavior-hold-tap";
            label = "BHS1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt_clr_1>;
            tapping-term-ms = <3000>;
            flavor = "hold-preferred";
        };

        bhs2: bhs2 {
            compatible = "zmk,behavior-hold-tap";
            label = "BHS2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt_clr_2>;
            tapping-term-ms = <3000>;
            flavor = "hold-preferred";
        };

        bhs3: bhs3 {
            compatible = "zmk,behavior-hold-tap";
            label = "BHS3";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt_clr_3>;
            tapping-term-ms = <3000>;
            flavor = "hold-preferred";
        };

        bhs4: bhs4 {
            compatible = "zmk,behavior-hold-tap";
            label = "BHS4";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&bt_clr_4>;
            tapping-term-ms = <3000>;
            flavor = "hold-preferred";
        };
    };

    macros {
        // Select profile N then immediately clear it - self-contained, works
        // regardless of which profile was active before. Referenced only by
        // the bhsN hold-tap behaviors above (hold side).
        bt_clr_0: bt_clr_0 {
            compatible = "zmk,behavior-macro";
            label = "BT_CLR_0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        bt_clr_1: bt_clr_1 {
            compatible = "zmk,behavior-macro";
            label = "BT_CLR_1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
        };

        bt_clr_2: bt_clr_2 {
            compatible = "zmk,behavior-macro";
            label = "BT_CLR_2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;
        };

        bt_clr_3: bt_clr_3 {
            compatible = "zmk,behavior-macro";
            label = "BT_CLR_3";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_CLR>;
        };

        bt_clr_4: bt_clr_4 {
            compatible = "zmk,behavior-macro";
            label = "BT_CLR_4";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&bt BT_CLR>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <13 14>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <11 12>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <13 12>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        lctrl {
            bindings = <&kp LCTRL>;
            key-positions = <23 24>;
            layers = <0>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
        };

        ctrl-shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <23 24 32>;
            layers = <0>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
        };

        lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <13 24>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        alt-shift {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <13 24 32>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        lgui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <14 24>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        gui-shift {
            bindings = <&kp LG(LEFT_SHIFT)>;
            key-positions = <14 24 32>;
            layers = <0>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <21 22>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <22 23>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 23>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <1 2>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        redo {
            bindings = <&kp LC(Y)>;
            key-positions = <2 3>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        sellect-all {
            bindings = <&kp LC(A)>;
            key-positions = <20 21>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        scroll-up {
            bindings = <&msc SCRL_UP>;
            key-positions = <6 7 8>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0 2>;
        };

        scroll-down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <26 27 28>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0 2>;
        };

        less-than {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        great-than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <25 26>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        lbrc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        rbrc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <17 18>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        rbkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <27 28>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <18 19>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        double-quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <8 9>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 29>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <16 7>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 8>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        under-score {
            bindings = <&kp UNDERSCORE>;
            key-positions = <16 9>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <16 18>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        qmark {
            bindings = <&kp QUESTION>;
            key-positions = <16 28>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <16 19>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <16 29>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <16 33>;
            timeout-ms = <25>;
            require-prior-idle-ms = <180>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <5 6>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q     &kp W   &kp E    &kp R     &kp T      &kp Y      &kp U     &kp I      &kp O    &kp P
&kp A     &kp S   &kp D    &kp F     &kp G      &kp H      &kp J     &kp K      &kp L    &kp SEMI
&kp Z     &kp X   &kp C    &kp V     &kp B      &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH
                  &kp RET  &mo 1     &kp ENTER  &kp SPACE  &mo 2     &kp RET
&kp LEFT  &kp UP  &kp RET  &kp DOWN  &kp RIGHT  &kp LEFT   &kp DOWN  &kp RET    &kp UP   &kp RIGHT
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_D_U>;
        };

        lower_layer {
            display-name = "lower_layer";
            bindings = <
&kp NUMBER_1       &kp N2          &kp N3        &kp N4     &kp N5        &kp N6          &kp N7          &kp N8        &kp N9           &kp N0
&kp PRINTSCREEN    &sk LEFT_SHIFT  &sk LEFT_ALT  &sk LCTRL  &sk LEFT_GUI  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE
&kp K_APPLICATION  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_GUI  &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp INSERT
                                   &trans        &trans     &kp ENTER     &kp SPACE       &trans          &trans
&trans             &trans          &trans        &trans     &trans        &trans          &trans          &trans        &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;

            label = "Lower Layer";
        };

        raise_layer {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR          &kp PERCENT          &kp CARET       &kp AMPERSAND   &kp ASTERISK  &kp EQUAL        &msc SCRL_UP
&trans           &trans       &mkp RCLK  &mkp LCLK           &mkp MCLK            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&trans           &trans       &trans     &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &mkp LCLK       &mkp RCLK       &trans        &trans           &trans
                              &trans     &trans              &mkp LCLK            &mkp RCLK       &trans          &trans
&trans           &trans       &trans     &trans              &trans               &trans          &trans          &trans        &trans           &trans
            >;

            label = "Raise Layer";
            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        fnc_layer {
            // Bluetooth profile keys: tap = select profile N (as before).
            // Hold ~3s = select AND clear that profile's bond in one action
            // (bhs0..bhs4, see the `behaviors` block up top) - use this to
            // remove pairing for ONE specific profile without touching the
            // others. `&bt BT_CLR` (bottom-right) still clears whatever
            // profile is *currently selected*; `&bt BT_CLR_ALL` still wipes
            // all 5. Remember to also "forget"/remove the device on the
            // host side after clearing here - ZMK only clears its own half
            // of the pairing.
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp F6        &kp F7  &kp F8          &kp F9  &kp F10
&trans  &trans  &trans  &trans  &kp F11       &kp F12       &trans  &trans          &trans  &trans
&bhs0   &bhs1   &bhs2   &bhs3   &bhs4         &kp CAPSLOCK  &trans  &bt BT_CLR_ALL  &trans  &bt BT_CLR
                        &trans  &trans        &out OUT_BLE  &out OUT_USB  &trans    &trans
&trans  &trans  &trans  &trans  &trans        &trans        &trans  &trans          &trans  &trans
            >;

            label = "FNC Layer";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fnc {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
